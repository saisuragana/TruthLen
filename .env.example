# Local Transformers inference. First use downloads model weights from Hugging Face.
TRUTHLEN_INFERENCE_MODE=local
TRUTHLEN_DEVICE=auto
TRUTHLEN_IMAGE_MODEL=prithivMLmods/AI-vs-Deepfake-vs-Real-Siglip2
TRUTHLEN_IMAGE_COMPARISON_MODEL=Deckard618/imdet/pe_tiny
TRUTHLEN_AUDIO_MODEL=MelodyMachine/Deepfake-audio-detection-V2
HF_TOKEN=

# Optional independent image/video AI detector. When set, images and videos
# are sent to Hive only after the uploader checks the on-screen consent box.
# Hive billing and data-retention terms apply; audio remains local.
HIVE_API_KEY=

# Optional: URLs of your own Hugging Face Inference Endpoints.
TRUTHLEN_IMAGE_ENDPOINT=
TRUTHLEN_AUDIO_ENDPOINT=

# Processing and retention.
TRUTHLEN_MAX_UPLOAD_MB=100
TRUTHLEN_MAX_VIDEO_FRAMES=12
TRUTHLEN_RETAIN_UPLOADS=false
TRUTHLEN_DATA_DIR=./data

# Set to redis when running the RQ worker.
TRUTHLEN_QUEUE_BACKEND=inline
TRUTHLEN_REDIS_URL=redis://localhost:6379/0
